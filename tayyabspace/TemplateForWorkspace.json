					},
					{
						"cell_type": "code",
						"source": [
							"from pyspark.sql.functions import *\n",
							"\n",
							"# ── 1. CONFIG\n",
							"raw_path    = \"abfss://ecommerce@tayyabadls.dfs.core.windows.net/raw/\"\n",
							"silver_path = \"abfss://ecommerce@tayyabadls.dfs.core.windows.net/silver/\"\n",
							"\n",
							"\n",
							"if not file_name:\n",
							"    raise ValueError(\"No file_name parameter received!\")\n",
							"\n",
							"# ── 3. READ\n",
							"df_raw = spark.read \\\n",
							"    .format(\"csv\") \\\n",
							"    .option(\"header\", \"true\") \\\n",
							"    .option(\"inferSchema\", \"true\") \\\n",
							"    .load(raw_path + file_name)\n",
							"\n",
							"# ── 4. SELECT columns\n",
							"df = df_raw.select(\n",
							"    \"user_id\", \"product_id\", \"category\", \"subcategory\",\"brand\", \"price\", \"discount\", \"final_price\",\n",
							"    \"rating\", \"review_count\", \"stock\", \"seller_id\", \"seller_rating\",\"purchase_date\", \"shipping_time_days\",\n",
							"    \"location\", \"device\", \"payment_method\",\"is_returned\", \"delivery_status\" )\n",
							"    \n",
							"# ── 5. TRANSFORM\n",
							"df_clean = df \\\n",
							"    .withColumn(\"purchase_date\",   to_date(col(\"purchase_date\"))) \\\n",
							"    .withColumn(\"category\",        trim(col(\"category\"))) \\\n",
							"    .withColumn(\"delivery_status\", trim(col(\"delivery_status\"))) \\\n",
							"    .withColumn(\"ingested_at\",     current_timestamp()) \\\n",
							"    .dropna(subset=[\"user_id\", \"product_id\", \"purchase_date\"])\n",
							"\n",
							"# print(f\"Rows after cleaning: {df_clean.count()}\")\n",
							"\n",
							"# ── 6. WRITE Delta to Silver\n",
							"df_clean.write \\\n",
							"    .format(\"delta\") \\\n",
							"    .mode(\"overwrite\") \\\n",
							"    .option(\"mergeSchema\", \"true\") \\\n",
							"    .save(silver_path)"
						],
						"outputs": [],
						"execution_count": null
					}
				]
			},
			"dependsOn": []
		},
